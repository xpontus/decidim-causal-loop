<%= prepend_javascript_pack_tag "decidim_causal_loop" %>
<style>
  .cl-toolbar .button { opacity: 1 !important; }
  .cl-toolbar .button:hover { opacity: 0.85 !important; filter: brightness(0.9); }
  .cl-toolbar .button.hollow:hover { background-color: transparent !important; }
  .cl-toolbar .button.hollow { color: inherit; }

  #cl-chat { display:none; flex-direction:column; border:1px solid #ddd; border-radius:4px; margin-top:0.75rem; background:#fff; }
  #cl-chat-messages { flex:1; min-height:180px; max-height:320px; overflow-y:auto; padding:0.75rem; display:flex; flex-direction:column; gap:0.4rem; }
  .cl-msg { padding:0.45rem 0.7rem; border-radius:8px; font-size:0.85rem; line-height:1.4; max-width:80%; white-space:pre-wrap; word-break:break-word; }
  .cl-msg--user      { align-self:flex-end; background:#4a90d9; color:#fff; }
  .cl-msg--assistant { align-self:flex-start; background:#f0f0f0; color:#333; }
  .cl-msg--error     { align-self:flex-start; background:#fde8e8; color:#c0392b; }
  .cl-msg--pending   { align-self:flex-start; background:#f0f0f0; color:#999; font-style:italic; }
  #cl-chat-footer { display:flex; gap:0.5rem; padding:0.5rem; border-top:1px solid #eee; }
  #cl-chat-input  { flex:1; padding:0.4rem 0.6rem; border:1px solid #ccc; border-radius:4px; font-size:0.9rem; }
  #cl-chat-input:focus { outline:none; border-color:#4a90d9; }
  #cl-chat-send   { white-space:nowrap; }

  .cl-readonly-notice {
    display:flex; align-items:flex-start; gap:0.5rem;
    margin-bottom:0.75rem; padding:0.6rem 0.8rem;
    border:1px solid #e0d6a8; border-left:3px solid #c9a227;
    border-radius:4px; background:#fdf9e7; color:#5c4a00; font-size:0.85rem;
  }
  .cl-readonly-notice strong { display:block; margin-bottom:0.15rem; }
</style>

<div class="row">
  <div class="columns">
    <h2 class="section-heading"><%= translated_attribute(current_component.name) %></h2>

    <div
      data-controller="causal-loop-editor"
      data-causal-loop-editor-nodes-value="<%= @nodes.map { |n| { id: n.id, title: n.title, description: n.description, position_x: n.position_x, position_y: n.position_y, width: n.width, height: n.height, font_size: n.font_size } }.to_json %>"
      data-causal-loop-editor-links-value="<%= @links.map { |l| { id: l.id, source_node_id: l.source_node_id, target_node_id: l.target_node_id, polarity: l.polarity, label: l.label, cp1_distance: l.cp1_distance.to_f, cp2_distance: l.cp2_distance&.to_f } }.to_json %>"
      data-causal-loop-editor-nodes-url-value="<%= Decidim::EngineRouter.main_proxy(current_component).nodes_path %>"
      data-causal-loop-editor-links-url-value="<%= Decidim::EngineRouter.main_proxy(current_component).links_path %>"
      data-causal-loop-editor-conversations-url-value="<%= Decidim::EngineRouter.main_proxy(current_component).agent_path %>"
      data-causal-loop-editor-editable-value="<%= @editable %>"
      data-causal-loop-editor-csrf-token-value="<%= form_authenticity_token %>"
    >
      <% if @editable %>
        <div class="cl-toolbar" style="margin-bottom:0.5rem; display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
          <button type="button" id="btn-add-node" class="button button--sc small">+ Add node</button>
          <button type="button" id="btn-add-link" class="button button--secondary small">&#8594; Add link</button>
          <button type="button" id="btn-delete"   class="button button--alert hollow small">&#x2715; Delete selected</button>
          <span style="width:1px; height:1.5rem; background:#ddd; margin:0 0.25rem;"></span>
          <span style="font-size:0.8rem; color:#666;">Node size:</span>
          <button type="button" id="btn-node-wider"    class="button hollow small" title="Wider">W+</button>
          <button type="button" id="btn-node-narrower" class="button hollow small" title="Narrower">W−</button>
          <button type="button" id="btn-node-taller"   class="button hollow small" title="Taller">H+</button>
          <button type="button" id="btn-node-shorter"  class="button hollow small" title="Shorter">H−</button>
          <span style="font-size:0.8rem; color:#666; margin-left:0.25rem;">Font:</span>
          <button type="button" id="btn-font-larger"   class="button hollow small" title="Larger font">A+</button>
          <button type="button" id="btn-font-smaller"  class="button hollow small" title="Smaller font">A−</button>
          <button type="button" id="btn-ai-chat"  class="button hollow small" style="margin-left:auto;">&#x1F916; AI Assistant</button>
          <span id="toolbar-status" style="color:#666; font-size:0.85rem;"></span>
        </div>
      <% end %>

      <div class="cl-toolbar" style="margin-bottom:0.75rem; display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
        <div style="display:flex; gap:0.25rem;">
          <button type="button" id="btn-zoom-out" class="button hollow small" title="Zoom out" style="min-width:2rem;">−</button>
          <button type="button" id="btn-fit"      class="button hollow small" title="Fit all">Fit</button>
          <button type="button" id="btn-zoom-in"  class="button hollow small" title="Zoom in"  style="min-width:2rem;">+</button>
        </div>
        <div style="display:flex; gap:0.25rem; margin-left:0.5rem;">
          <button type="button" id="btn-export-json"    class="button hollow small">Export JSON</button>
          <button type="button" id="btn-export-graphml" class="button hollow small">Export GraphML</button>
          <button type="button" id="btn-save-png"       class="button hollow small">Save PNG</button>
          <button type="button" id="btn-print-pdf"      class="button hollow small">Print / PDF</button>
        </div>
      </div>

      <% unless @editable %>
        <div class="cl-readonly-notice" role="status">
          <span aria-hidden="true">&#128274;</span>
          <span>
            <strong>You do not have edit access to this diagram.</strong>
            You can view, zoom and export it, but not change it.
            <% if current_user.blank? %>
              Sign in with an account that has edit access to make changes.
            <% else %>
              An administrator can grant you access under the component&rsquo;s
              <em>Editors</em> settings in the admin panel.
            <% end %>
          </span>
        </div>
      <% end %>

      <% if @editable %>
      <p style="color:#999; font-size:0.8rem; margin-bottom:0.5rem;">
        Double-click empty canvas to create a node. Hold <kbd>C</kbd> over a node to draw a link. Double-click a node to rename it. Click a link to toggle +/−. <kbd>Shift</kbd>+click for multi-selection. <kbd>Delete</kbd> removes selected.
      </p>
      <% end %>

      <div id="cy" style="width:100%; height:600px; border:1px solid #ddd; border-radius:4px; background:#fafafa; position:relative;"></div>

      <% if @nodes.empty? %>
        <p style="text-align:center; color:#999; margin-top:1rem;">
          No nodes yet.<%= @editable ? " Double-click the canvas to start, or ask the AI assistant." : "" %>
        </p>
      <% end %>

      <% if @editable %>
        <div id="cl-chat">
          <div id="cl-chat-messages">
            <div class="cl-msg cl-msg--assistant">Hi! I can help you build and analyse this causal loop diagram. Ask me to add nodes and links, explain loops, or describe a system and I'll sketch it for you.</div>
          </div>
          <div id="cl-chat-footer">
            <input type="text" id="cl-chat-input" placeholder="e.g. "Add a reinforcing loop about staff burnout"" autocomplete="off">
            <button type="button" id="cl-chat-send" class="button small button--sc cl-chat-send">Send</button>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
